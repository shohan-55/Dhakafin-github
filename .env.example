# ─────────────────────────────────────────────────────────────────────────────
# DhakaFin environment template — Phase 1 (DF-P1-001 … 015)
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never be
# committed. On the server, these come from the host's secret store — not a file.
#
# Nothing in Phase 1 requires any of these to boot. The web app builds and runs
# with an empty environment by design: a marketing site should not fail because a
# database is asleep.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin. Used for canonical URLs, sitemap, JSON-LD and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to '1' to emit X-Robots-Tag: noindex on every response. Use on staging,
# and on preview deployments so previews never compete with production in search.
NEXT_PUBLIC_NOINDEX=0

# ── Backend (Phase 3+) ───────────────────────────────────────────────────────
# The Laravel API. In development the browser must NOT call this directly —
# requests go to /api/* on the Next origin and are proxied server-side, so the
# preview host and CORS never become a browser concern.
API_INTERNAL_URL=http://127.0.0.1:8000
API_PUBLIC_URL=http://localhost:3000/api

# ── Database (Phase 3+ — Laravel, not read by the web app) ───────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dhakafin
DB_USERNAME=dhakafin
DB_PASSWORD=

# ── Admin panel (Phase 3+ — Filament v4) ─────────────────────────────────────
# FRONTEND_URL powers the password-reset and invitation links.
FRONTEND_URL=http://localhost:3000
ADMIN_PATH=admin
# Rotate this on every environment. Never reuse across staging and production.
APP_KEY=

# ── Regulatory data (Phase 3+) ───────────────────────────────────────────────
# Rates are NEVER hardcoded and NEVER seeded from source code. They are imported
# from the reviewed CSV template (docs/blueprint/Appendix_C_Rates_Seed_Template.csv)
# and every row carries a verifier and a source citation before it can go live.
RATES_REQUIRE_VERIFICATION=true
RATES_IMPORT_PATH=docs/blueprint/Appendix_C_Rates_Seed_Template.csv

# ── Integrations (Phase 5+) ──────────────────────────────────────────────────
# Payments — bKash / Nagad / SSLCommerz (sandbox credentials in development).
PAYMENT_PROVIDER=sandbox
PAYMENT_MERCHANT_ID=
PAYMENT_STORE_PASSWORD=

# Transactional email / SMS (Bangla and English templates).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@dhakafin.com
MAIL_FROM_NAME=DhakaFin
SMS_PROVIDER=log

# ── Observability (Phase 1, DF-P1-013 — deferred, see docs/blueprint) ────────
# Deliberately empty in Phase 1: nothing is installed until hosting exists
# (DF-P1-011), so collecting an endpoint here would be a false promise.
SENTRY_DSN=
