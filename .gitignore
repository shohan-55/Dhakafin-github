# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output ───────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo

# ─── Generated token artifacts are COMMITTED on purpose ─────────
# packages/tokens/dist/* is generated by `npm run tokens:build` and is
# intentionally tracked so that apps can build without running the generator
# first, and so a token change is visible in the diff (ADR-001).
#
# Git will not descend into an excluded directory, so the directory itself must
# be re-included before its contents can be. Both lines are required.
!packages/tokens/dist/
!packages/tokens/dist/**

# ─── Environment / secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Editors / OS ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ─── Testing / coverage ─────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ─── Laravel (apps/api — added in Phase 5) ──────────────────────
apps/api/vendor/
apps/api/storage/*.key
apps/api/.phpunit.result.cache
apps/api/public/storage
apps/api/public/hot

# ─── Misc ───────────────────────────────────────────────────────
.turbo/
.cache/
*.pem
